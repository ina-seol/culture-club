{
  "name": "culture-club",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "backup": "node server/backup.mjs",
    "build:cloud": "node scripts/build-cloud.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project demo-culture-club \"node --test firebase/tests/*.test.mjs\""
  },
  "dependencies": {
    "firebase": "^13.3.0",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "firebase-tools": "^15.36.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.13.6"
  }
}
